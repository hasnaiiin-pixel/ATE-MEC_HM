{
  "name": "at-mec-hm-4-12b",
  "version": "4.12.2",
  "description": "AT-MEC HM 4.12B - Analisi Produzione e Archivio Dati additivi su base stabile 4.12",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "electron dist/main/main.js",
    "dev": "npm run build && concurrently \"npm run watch\" \"wait-on dist/main/main.js && electron dist/main/main.js\"",
    "package": "npm run build && electron-builder",
    "setup": "npm install",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:setup": "npm run build && electron-builder --win nsis",
    "package:all": "npm run build && electron-builder --win portable nsis",
    "audit": "node scripts/project_audit.js"
  },
  "build": {
    "appId": "com.atemec.platform",
    "productName": "AT-MEC HM 4.12B",
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "shortcutName": "AT-MEC HM 4.12B"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AT-MEC HM 4.12B"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "remote_dashboard.html",
      "package.json",
      "assets/**/*",
      "config/**/*",
      "firmware/**/*",
      "docs/**/*",
      "data/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      "firmware/**/*",
      "docs/**/*",
      "drivers/**/*",
      "scripts/**/*"
    ]
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "modbus-serial": "^8.0.17",
    "pdfkit": "^0.15.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  }
}
