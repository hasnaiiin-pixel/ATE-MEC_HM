{
  "name": "at-mec-hm-8-0-ai-ready-enterprise-stable",
  "version": "8.0.0",
  "description": "AT-MEC_HM_8.0_AI_READY_ENTERPRISE_STABLE",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "electron dist/main/main.js",
    "dev": "npm run build && concurrently \"npm run watch\" \"wait-on dist/main/main.js && electron dist/main/main.js\"",
    "package": "npm run build && electron-builder",
    "setup": "npm install",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:setup": "npm run build && electron-builder --win nsis",
    "package:all": "npm run build && electron-builder --win portable nsis",
    "audit": "node scripts/project_audit.js",
    "audit:enterprise": "node scripts/enterprise_audit_422.js",
    "backup": "node scripts/backup_restore_423c.js backup",
    "backup:full": "node scripts/backup_restore_423c.js backup",
    "restore": "node scripts/backup_restore_423c.js restore",
    "backup:list": "node scripts/backup_restore_423c.js list",
    "backup:check": "node scripts/backup_restore_423c.js check",
    "backup:integrity": "node scripts/backup_restore_423c.js integrity",
    "backup:schedule": "node scripts/backup_restore_423c.js schedule",
    "backup:run-scheduled": "node scripts/backup_restore_423c.js run-scheduled",
    "clone:export": "node scripts/backup_restore_423c.js clone-export",
    "clone:import": "node scripts/backup_restore_423c.js clone-import",
    "db:audit": "node scripts/sqlite_foundation_66a.js audit",
    "db:backup-pre-migration": "node scripts/sqlite_migration_66b.js backup",
    "db:status": "node scripts/sqlite_foundation_66a.js status",
    "db:migrate": "node scripts/sqlite_migration_66b.js migrate",
    "db:migration-report": "node scripts/sqlite_migration_66b.js report",
    "db:integrity": "node scripts/sqlite_enterprise_66c.js integrity",
    "db:audit-trail": "node scripts/sqlite_enterprise_66c.js audit",
    "db:backup-sqlite": "node scripts/sqlite_enterprise_66c.js backup",
    "db:performance": "node scripts/sqlite_enterprise_66c.js performance",
    "db:cleanup-report": "node scripts/sqlite_enterprise_66c.js cleanup",
    "db:enterprise-status": "node scripts/sqlite_enterprise_66c.js status",
    "cleanup:audit": "node scripts/cleanup_audit_75.js",
    "runtime:validate": "node scripts/runtime_validate_80.js",
    "startup:doctor": "node scripts/startup_doctor_80.js"
  },
  "build": {
    "appId": "com.atemec.platform",
    "productName": "ATE-MEC HM 8.0 AI READY ENTERPRISE STABLE",
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "shortcutName": "ATE-MEC HM 8.0 AI READY ENTERPRISE STABLE"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ATE-MEC HM 8.0 AI READY ENTERPRISE STABLE"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "remote_dashboard.html",
      "package.json",
      "assets/**/*",
      "config/**/*",
      "firmware/**/*",
      "docs/**/*",
      "data/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      "firmware/**/*",
      "docs/**/*",
      "drivers/**/*",
      "scripts/**/*"
    ]
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "modbus-serial": "^8.0.17",
    "pdfkit": "^0.15.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.5",
    "wait-on": "^9.0.10"
  },
  "productName": "ATE-MEC HM 8.0 AI READY ENTERPRISE STABLE",
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  }
}